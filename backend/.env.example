# ==============================================================================
# The Interview Agent Environment Configuration
# Copy this file to .env in backend/ and fill in your preferred provider API key.
# ==============================================================================

# Which AI provider the LLM service should use:
# Options: 'gemini' | 'anthropic' | 'openai' | 'mock'
LLM_PROVIDER=gemini

# Model name override (optional - defaults to best model per provider)
# LLM_MODEL=gemini-2.0-flash

# Google Gemini API key
GEMINI_API_KEY=your-gemini-api-key-here

# Anthropic Claude API key
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI API key (or OpenRouter / Groq with OPENAI_BASE_URL)
OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Automatic fallback to mock mode if live API call fails or key is missing
MOCK_FALLBACK_ON_ERROR=true
